#!/usr/bin/env bash
# Stub GDAL ogrinfo for exercising bin/s57-to-tiles' and bin/extract-coverage's
# control flow.
#
# See test/s57-to-tiles.test.js and test/extract-coverage.test.js. Every knob is
# an environment variable:
#
#   STUB_TABLES            feature tables the GPKG appears to hold
#                          (default "DEPARE M_COVR SOUNDG"; " " for none)
#   STUB_COLUMNS           attribute columns every layer appears to hold
#                          (default "OBJNAM INTU")
#   STUB_HAS_MASK          rows in quilt_mask, the union of all FINER coverage
#                          (0 = no finer chart overlaps this cell)
#   STUB_HAS_COARSER       rows in quilt_mask_coarser, the union of all COARSER
#                          coverage (0 = nothing lies beneath this cell)
#   STUB_FINER_FLOORS      the distinct QFLOORs of the finer coverage, ascending
#                          (default none: no ladder above the whole copy)
#   STUB_CSCALE            DSPM_CSCL on the DSID layer ("none" to omit it)
#   STUB_INTU              DSID_INTU on the DSID layer (default 5)
#   STUB_EXTENT            the M_COVR bbox `-so` reports, as GDAL prints it
#   STUB_PRE_TOTAL         rows counted BEFORE the clip (default STUB_TOTAL)
#   STUB_TOTAL             rows counted AFTER the clip (default 0)
#   STUB_PRE_COUNT_FAILS   the pre-clip counting query exits non-zero
#   STUB_COUNT_FAILS       the post-clip counting query exits non-zero
#   STUB_COUNT_GARBAGE     the post-clip count comes back with no integer in it
#   STUB_COUNT_TYPE        the count column's OGR type (Integer/Integer64)
#   STUB_STATE             file used to tell the pre-clip count from the
#                          post-clip one; they are the same query text
#   STUB_SQL_LOG           file every -sql statement is appended to, so a test
#                          can read back the copy ladder the script built. One
#                          file per RUN: the entries accumulate.
set -u

args="$*"

emit_count() {
  echo "Layer name: SELECT"
  echo "OGRFeature(SELECT):0"
  echo "  n (${STUB_COUNT_TYPE:-Integer}) = $1"
}

case "$args" in
  *-sql*)
    sql="${args#*-sql }"
    [ -n "${STUB_SQL_LOG:-}" ] && printf '%s\n--\n' "$sql" >>"$STUB_SQL_LOG"
    case "$sql" in
      # Checked before the generic "AS n" arm: the mask probes are also aliased
      # n. Most specific table name first -- quilt_mask_coarser also matches the
      # per-rung pattern, and both also match the bare one.
      *"AS n FROM quilt_mask_coarser WHERE"*)
        emit_count "${STUB_HAS_COARSER:-0}"
        exit 0
        ;;
      *"AS n FROM quilt_mask_"*)
        # A rung mask is built from rows that exist, so it is never empty.
        emit_count 1
        exit 0
        ;;
      *"AS n FROM quilt_mask WHERE"*)
        emit_count "${STUB_HAS_MASK:-1}"
        exit 0
        ;;
      *"pragma_table_info"*)
        # Schema-as-data read quilt_columns uses. One row per column, the
        # exact shape real GDAL prints for a sqlite-dialect SELECT. fid and
        # geom rows included deliberately: the caller must exclude them.
        i=0
        for c in fid geom ${STUB_COLUMNS:-OBJNAM INTU}; do
          echo "OGRFeature(SELECT):$i"
          echo "  name (String) = $c"
          i=$((i + 1))
        done
        exit 0
        ;;
      *"DISTINCT QFLOOR"*)
        i=0
        for f in ${STUB_FINER_FLOORS:-}; do
          echo "OGRFeature(SELECT):$i"
          echo "  QFLOOR (Integer) = $f"
          i=$((i + 1))
        done
        exit 0
        ;;
      *"FROM coverage"*)
        emit_count "${STUB_TOTAL:-1}"
        exit 0
        ;;
      *"SELECT DISTINCT GeometryType"*)
        echo "POLYGON"
        exit 0
        ;;
      *" AS n"*)
        state="${STUB_STATE:-/tmp/enc-tiles-stub-seq}"
        seq=$(($(cat "$state" 2>/dev/null || echo 0) + 1))
        echo "$seq" >"$state"
        if [ "$seq" = "1" ]; then
          [ "${STUB_PRE_COUNT_FAILS:-0}" = "1" ] && {
            echo "ERROR 1: SQL Expression Parsing Error: syntax error" >&2
            exit 1
          }
          emit_count "${STUB_PRE_TOTAL:-${STUB_TOTAL:-0}}"
          exit 0
        fi
        [ "${STUB_COUNT_FAILS:-0}" = "1" ] && {
          echo "ERROR 1: SQL Expression Parsing Error: syntax error" >&2
          exit 1
        }
        if [ "${STUB_COUNT_GARBAGE:-0}" = "1" ]; then
          # Exit 0 with output that carries no count at all -- the shape a
          # GDAL build that reported the error and kept going leaves behind.
          echo "Layer name: SELECT"
          exit 0
        fi
        emit_count "${STUB_TOTAL:-0}"
        exit 0
        ;;
      *)
        # ALTER TABLE / UPDATE / INSERT / DELETE / CREATE TABLE: no output, no
        # failure.
        exit 0
        ;;
    esac
    ;;
  "-so "*)
    # Real GDAL without -q prints an "INFO: Open of ..." banner before the
    # summary — the line that parsed as a column named INFO and killed every
    # copy INSERT. Emitted here so any future summary-parsing regresses
    # loudly in the suite.
    case " $* " in
      *" -q "*) : ;;
      *) echo "INFO: Open of \`$2' using driver \`GPKG' successful." ;;
    esac
    # The layer summary the rung's mid-latitude and the copy ladder's column
    # list are read off. Anchored at the start of the argument line: a tmpdir
    # name is free to contain "-so".
    #
    # Real GDAL 3.13 suppresses this whole summary under -q — only the layer
    # name survives — which is exactly how every extract-coverage invocation
    # in the first real v4 run read no extent and skipped every chart. The
    # stub mirrors that so a -q on this read can never pass the suite again.
    case " $* " in
      *" -q "*)
        echo "Layer name: ${*: -1}"
        exit 0
        ;;
    esac
    echo "Layer name: ${*: -1}"
    echo "Geometry: Polygon"
    echo "Feature Count: 1"
    echo "Extent: ${STUB_EXTENT-(-122.900000, 48.000000) - (-122.100000, 49.000000)}"
    echo "FID Column = fid"
    echo "Geometry Column = geom"
    for c in ${STUB_COLUMNS:-OBJNAM INTU}; do
      echo "$c: String (0.0)"
    done
    exit 0
    ;;
  *DSID*)
    # Empty rather than absent for either field: GDAL leaves the line out of a
    # DSID dump when the chart does not carry it.
    [ -z "${STUB_INTU-5}" ] || echo "  DSID_INTU (Integer) = ${STUB_INTU-5}"
    [ "${STUB_CSCALE:-12000}" = "none" ] || echo "  DSPM_CSCL (Integer) = ${STUB_CSCALE:-12000}"
    exit 0
    ;;
esac

# Plain listing of the feature tables.
i=1
for t in ${STUB_TABLES:-DEPARE M_COVR SOUNDG}; do
  echo "$i: $t (Polygon)"
  i=$((i + 1))
done
exit 0
