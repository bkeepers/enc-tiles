#!/usr/bin/env node

// Derives the _LABELS layer: one label anchor per named land or sea area.
//
// Usage:
//   bin/generate-labels <output.geojson> --class LNDARE:LNDARE.geojson \
//     [--class LNDRGN:LNDRGN.geojson] [--class SEAARE:SEAARE.geojson]
//
// Why this layer exists:
//
//   An S-57 cell splits a named feature across as many polygons as its
//   topology needs -- an island group is one LNDARE per island, a bay is
//   several SEAARE parts -- and every one of them carries the same OBJNAM. A
//   symbol layer with a text-field over the class draws the name once per
//   polygon, so a chart of an archipelago repeats the same island name a
//   dozen times and MapLibre's collision detection thins them arbitrarily.
//
//   Grouping by (OBJNAM, INTU) and emitting a single anchor per group gives
//   the style one label per name per chart scale. INTU is part of the key
//   because the quilt carries several charts at once and each keeps its own
//   labelling.
//
// Each output feature carries OBJNAM, CLASS (the S-57 class of the largest
// member), INTU, and AREA (the summed area of the group, in square degrees
// scaled by cos(latitude) so it ranks sensibly across latitudes). The style
// uses AREA to size and prioritise the text.

import { readFileSync, writeFileSync } from "fs";

const args = process.argv.slice(2);
const inputs = [];
const positional = [];

for (let i = 0; i < args.length; i++) {
  if (args[i] === "--class" && args[i + 1]) {
    const value = args[++i];
    const separator = value.indexOf(":");
    inputs.push({
      className: value.slice(0, separator),
      path: value.slice(separator + 1),
    });
  } else positional.push(args[i]);
}

const outputPath = positional[0];
if (!outputPath || inputs.length === 0) {
  console.error(
    "Usage: generate-labels <output.geojson> --class <CLASS>:<file.geojson> [--class ...]",
  );
  process.exit(1);
}

function readFeatures(path) {
  let text;
  try {
    text = readFileSync(path, "utf8");
  } catch (err) {
    return [];
  }
  if (!text.trim()) return [];
  return JSON.parse(text).features ?? [];
}

/** The polygons of a geometry, each as an array of rings. */
function polygons(geometry) {
  if (!geometry) return [];
  if (geometry.type === "Polygon") return [geometry.coordinates];
  if (geometry.type === "MultiPolygon") return geometry.coordinates;
  return [];
}

function ringArea(ring) {
  let sum = 0;
  for (let i = 1; i < ring.length; i++) {
    sum += ring[i - 1][0] * ring[i][1] - ring[i][0] * ring[i - 1][1];
  }
  return sum / 2;
}

/** Signed-area centroid of a ring. */
function ringCentroid(ring) {
  let x = 0;
  let y = 0;
  let area = 0;
  for (let i = 1; i < ring.length; i++) {
    const [x0, y0] = ring[i - 1];
    const [x1, y1] = ring[i];
    const cross = x0 * y1 - x1 * y0;
    area += cross;
    x += (x0 + x1) * cross;
    y += (y0 + y1) * cross;
  }
  area /= 2;
  if (area === 0) return ring[0];
  return [x / (6 * area), y / (6 * area)];
}

function pointInRings(point, polygon) {
  let inside = false;
  for (const ring of polygon) {
    for (let i = 1; i < ring.length; i++) {
      const [x0, y0] = ring[i - 1];
      const [x1, y1] = ring[i];
      if (y0 > point[1] !== y1 > point[1]) {
        const x = x0 + ((point[1] - y0) * (x1 - x0)) / (y1 - y0);
        if (x > point[0]) inside = !inside;
      }
    }
  }
  return inside;
}

/**
 * A point guaranteed to lie inside the polygon: the centroid when it is
 * interior, otherwise the middle of the widest interior span of the horizontal
 * line through it. (The full pole-of-inaccessibility search buys very little
 * for chart-scale land and sea areas and costs a lot more code.)
 */
function pointOnSurface(polygon) {
  const centroid = ringCentroid(polygon[0]);
  if (pointInRings(centroid, polygon)) return centroid;

  const y = centroid[1];
  const crossings = [];
  for (const ring of polygon) {
    for (let i = 1; i < ring.length; i++) {
      const [x0, y0] = ring[i - 1];
      const [x1, y1] = ring[i];
      if (y0 > y !== y1 > y) {
        crossings.push(x0 + ((y - y0) * (x1 - x0)) / (y1 - y0));
      }
    }
  }
  crossings.sort((a, b) => a - b);

  let best;
  let bestWidth = -1;
  for (let i = 0; i + 1 < crossings.length; i += 2) {
    const width = crossings[i + 1] - crossings[i];
    if (width > bestWidth) {
      bestWidth = width;
      best = (crossings[i] + crossings[i + 1]) / 2;
    }
  }
  return best === undefined ? centroid : [best, y];
}

/** Area in square degrees, longitude scaled by cos(latitude). */
function featureArea(geometry) {
  let total = 0;
  for (const polygon of polygons(geometry)) {
    const latitude = (ringCentroid(polygon[0])[1] * Math.PI) / 180;
    const scale = Math.max(Math.cos(latitude), 0.01);
    // Holes come out with the opposite winding, so the signed sum subtracts them.
    for (const ring of polygon)
      total +=
        Math.abs(ringArea(ring)) * scale * (ring === polygon[0] ? 1 : -1);
  }
  return Math.abs(total);
}

function anchorOf(feature) {
  const geometry = feature.geometry;
  if (!geometry) return undefined;
  if (geometry.type === "Point") return geometry.coordinates;
  if (geometry.type === "MultiPoint") return geometry.coordinates[0];

  const shapes = polygons(geometry);
  if (shapes.length === 0) return undefined;
  // Label the biggest part of a multipolygon, not the average of the parts,
  // which for an island chain lands in open water.
  let biggest = shapes[0];
  let biggestArea = -1;
  for (const polygon of shapes) {
    const area = Math.abs(ringArea(polygon[0]));
    if (area > biggestArea) {
      biggestArea = area;
      biggest = polygon;
    }
  }
  return pointOnSurface(biggest);
}

const groups = new Map();

for (const { className, path } of inputs) {
  for (const feature of readFeatures(path)) {
    const name = feature.properties?.OBJNAM;
    if (typeof name !== "string" || name.trim() === "") continue;
    const intu = feature.properties?.INTU ?? null;
    const id = `${name}\u0000${intu}`;

    const area = featureArea(feature.geometry);
    const group = groups.get(id) ?? {
      name,
      intu,
      area: 0,
      best: { area: -1, className, anchor: undefined },
    };
    group.area += area;
    if (area > group.best.area) {
      const anchor = anchorOf(feature);
      if (anchor) group.best = { area, className, anchor };
    }
    groups.set(id, group);
  }
}

const features = [];
for (const group of groups.values()) {
  if (!group.best.anchor) continue;
  features.push({
    type: "Feature",
    // NOT a property: tippecanoe reads this member off the Feature itself. It
    // drops a fraction of POINT features at every zoom below the maxzoom
    // (-r/--drop-rate, default 2.5), and there is exactly ONE label anchor per
    // named area -- drop it and the area loses its name at that zoom with
    // nothing to fall back on. --drop-rate is a whole-run knob, so turning it
    // off would also stop the SOUNDG thinning that keeps small-scale tiles
    // readable; a per-feature `minzoom` is the only exemption tippecanoe
    // scopes. See bin/s57-to-tiles step 4.
    tippecanoe: { minzoom: 0 },
    geometry: { type: "Point", coordinates: group.best.anchor },
    properties: {
      OBJNAM: group.name,
      CLASS: group.best.className,
      ...(group.intu === null ? {} : { INTU: group.intu }),
      AREA: group.area,
    },
  });
}

writeFileSync(
  outputPath,
  JSON.stringify({ type: "FeatureCollection", features }),
);
console.error(`Generated ${features.length} label anchors`);
