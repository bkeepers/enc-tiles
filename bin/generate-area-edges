#!/usr/bin/env node

// Derives the _AREA_EDGE layer: the boundaries of EVERY styled area class,
// drawn only where the content actually CHANGES across them.
//
// Usage:
//   bin/generate-area-edges <output.geojson> \
//     --area RESARE:RESARE.geojson [--area CTNARE:CTNARE.geojson ...] \
//     [--coverage quilting_coverage.geojson] [--cell-coverage M_COVR.geojson] \
//     [--neighbor-coverage quilting_neighbors.geojson] \
//     [--neighbor-area-evidence area_evidence.geojson]
//
//   bin/generate-area-edges --list-classes
//     prints the participating classes, one per line, which is how
//     bin/s57-to-tiles knows what to feed it -- one source of truth, here.
//
// THE BOUNDARY MERGE RULE (user directive, stated once):
//
//   An area feature's boundary draws ONLY where the content changes across it.
//   Two polygons of the same class meeting at a chart (cell) seam with
//   identical S-57 content merge silently -- no line, no dentate marks. ANY
//   content difference keeps the full boundary presentation.
//
//   The live defect this generalises away: a restricted area continuing across
//   cell seams drew its symbolized toothed line at every chart border, and the
//   same ruled-into-boxes defect existed for every other stroked area class.
//   _MQUAL_EDGE, _BUAARE_EDGE and _DEPARE_EDGE each fixed it for ONE class;
//   this layer is the same derivation (bin/quilt-edges.mjs) run PER CLASS over
//   every remaining area class the style strokes.
//
// WHAT COUNTS AS THE SAME CONTENT
//
//   The feature's full attribute set, minus the bookkeeping that identifies
//   the RECORD rather than the thing in the water (see IDENTITY_EXCLUSIONS).
//   Two RESARE fragments carrying the same RESTRN, the same INFORM and the
//   same everything else are one regulated area however the topology split
//   them; two differing in ANY surviving attribute -- a name, a restriction
//   list, a category -- are different areas and the line between them stands.
//
// PER-SIDE EMISSION
//
//   An edge where content differs is emitted ONCE PER SIDE, each copy carrying
//   ITS side's attributes and the CANONICAL orientation of ITS side's ring --
//   filled side on the right of travel, whatever way the source happened to
//   wind it (see orientedRings in bin/quilt-geojson.mjs). Each area's own
//   boundary presentation then draws its own style facing its own interior --
//   the S-52 line-mark orientation invariant (marks point INTO the filled
//   side) is what makes per-side emission the correct model rather than a
//   duplication. Exact-duplicate sides of one segment are deduplicated: three
//   owners two of which agree emit two edges, not three. An edge with only one
//   side present (the ordinary outline) is emitted once, with that side's
//   attributes.
//
// THE CHART BORDER
//
//   A ONE-SIDED segment -- one owner, or overlapping areas truncated together,
//   every interior on the same side -- lying along a quilt cut (--coverage) or
//   this cell's M_COVR ring (--cell-coverage) is a CANDIDATE chart seam. The
//   other charts' M_COVR roster (--neighbor-coverage) selects the serving floor
//   for this copy-ladder interval and every DSNM that owns the far-side probe
//   there. The cached semantic roster (--neighbor-area-evidence) then suppresses
//   one current side ONLY when EVERY serving DSNM contains the same CLASS and
//   exact content identity. One different owner, or one owner whose manifest
//   proved the class absent, keeps the boundary. That is the evidence the old
//   coverage-only presumption lacked: identical cross-cell content merges, but
//   a real change exactly at a cell edge stands.
//
//   Where no chart lies across the ring, the truncation is the true charted end
//   of the area -- NOAA runs data limits along real maritime limits, the
//   US/Russia EEZ line above all -- and the presentation stands. Without the
//   semantic roster an older caller retains the historical unconditional seam
//   drop; cached fragments are accepted only with a manifest, so missing or
//   malformed evidence never reaches the evidence-aware path as "absence".
//
// Each output feature carries:
//
//   CLASS      the S-57 class the boundary belongs to, which is what the
//              style's retargeted per-class boundary copies filter on
//   <attrs>    the owning side's full content attribute set (everything the
//              identity was hashed over), so the vendored per-class boundary
//              filters -- RESTRN, CATREA, ORIENT, CATACH and the rest -- read
//              the edge exactly as they read the polygon it outlines
//
// plus the copy ladder's _QZMIN/_QZMAX/_QFALL, converted to per-feature
// tippecanoe zoom bounds later by bin/stamp-quilt-zooms. Deliberately NOT
// carried: SCAMIN/SCAMAX (the partition owns scale gating, and the facade's
// retargeted layers rely on the gates being inert -- the same contract as
// _BUAARE_EDGE and _RESTR_ANCHORS) and the identity exclusions themselves.

import { writeFileSync } from "fs";

import {
  chartBorderTest,
  coveragePolygons,
  deriveDifferEdges,
  outwardProbe,
  polygonsContaining,
} from "./quilt-edges.mjs";
import { readFeatures } from "./quilt-geojson.mjs";

/**
 * The participating classes: every AREA class for which the generated style
 * emits a boundary LINE presentation -- a plain dashed line layer, an LC()
 * symbolized pen, or a line-placed LM_ mark layer -- enumerated from
 * @enc-tiles/styles under both boundary modes. test/generate-area-edges.test.js
 * re-derives this list from the style generator and fails on drift, so an
 * upstream class gaining or losing a stroked boundary cannot silently miss the
 * merge rule.
 *
 * Excluded from participation, with the layer that already owns each:
 *
 *   BUAARE            _BUAARE_EDGE (bin/generate-buaare-edges; OBJNAM identity)
 *   DEPARE, DRGARE    _DEPARE_EDGE (bin/generate-depare-edges; the safety
 *                     contour needs its seams FLAGGED, not dropped). DRGARE's
 *                     only stroked presentation in the bundle is its depth
 *                     boundary, so it has no separate area-outline role here.
 *   M_QUAL            _MQUAL_EDGE (bin/generate-mqual-edges; CATZOC pairs)
 *   M_NPUB, M_NSYS    cell metadata -- the plotroom facade drops the classes'
 *                     whole generated presentation, so there is no boundary
 *                     left to retarget
 *
 * and the style generator's non-S-57 pseudo classes ("######", the
 * unknown-object fallback, and the lowercase mariner/manufacturer overlay
 * classes), which never name a tile source-layer.
 */
export const AREA_EDGE_CLASSES = [
  "ACHARE",
  "ACHBRT",
  "ADMARE",
  "AIRARE",
  "ARCSLN",
  "BRIDGE",
  "BUISGL",
  "CANALS",
  "CAUSWY",
  "CBLARE",
  "CONVYR",
  "CONZNE",
  "COSARE",
  "CRANES",
  "CTNARE",
  "CTSARE",
  "CUSZNE",
  "DAMCON",
  "DMPGRD",
  "DOCARE",
  "DRYDOC",
  "DWRTPT",
  "DYKCON",
  "EXEZNE",
  "FAIRWY",
  "FERYRT",
  "FLODOC",
  "FORSTC",
  "FRPARE",
  "FSHFAC",
  "FSHGRD",
  "FSHZNE",
  "GATCON",
  "GRIDRN",
  "HRBARE",
  "HULKES",
  "ICEARE",
  "ICNARE",
  "ISTZNE",
  "LAKARE",
  "LNDMRK",
  "LOCMAG",
  "LOGPON",
  "LOKBSN",
  "MARCUL",
  "MIPARE",
  "MORFAC",
  "NEWOBJ",
  "OBSTRN",
  "OFSPLF",
  "OSPARE",
  "PILBOP",
  "PIPARE",
  "PONTON",
  "PRCARE",
  "PRDARE",
  "PYLONS",
  "RADRNG",
  "RECTRC",
  "RESARE",
  "RIVERS",
  "ROADWY",
  "RUNWAY",
  "SBDARE",
  "SILTNK",
  "SLCONS",
  "SLOGRD",
  "SMCFAC",
  "SNDWAV",
  "SPLARE",
  "SUBTLN",
  "SWPARE",
  "TESARE",
  "TIDEWY",
  "TS_FEB",
  "TS_PAD",
  "TS_PNH",
  "TS_PRH",
  "TS_TIS",
  "TUNNEL",
  "TWRTPT",
  "T_HMON",
  "T_NHMN",
  "T_TIMS",
  "UNSARE",
  "UWTROC",
  "VEGATN",
  "WATTUR",
  "WEDKLP",
  "WRECKS",
];

/**
 * The attributes that identify the RECORD, not the content -- excluded from
 * the identity hash AND from the emitted edge's attributes.
 *
 * The first group is per-feature bookkeeping: LNAM is the feature identifier
 * (every fragment pair across a boundary differs in it by construction), the
 * source/record dates and indicators describe the survey record, and
 * SCAMIN/SCAMAX/INTU/CSCALE are scale gating the partition owns. The second
 * group is the tile-side exclusion list bin/s57-to-tiles already passes to
 * tippecanoe (--exclude): attributes that never reach a tile cannot be
 * content, and FIDN alone would otherwise keep any two distinct features from
 * ever merging. Every _-prefixed stamp (the copy ladder's and any other of
 * ours) is excluded by prefix.
 */
const IDENTITY_EXCLUSIONS = new Set([
  "LNAM",
  "SORIND",
  "SORDAT",
  "RECIND",
  "RECDAT",
  "SCAMIN",
  "SCAMAX",
  "INTU",
  "CSCALE",
  // The tippecanoe --exclude list from bin/s57-to-tiles, step 4.
  "LNAM_REFS",
  "FFPT_RIND",
  "PRIM",
  "GRUP",
  "OBJL",
  "RVER",
  "AGEN",
  "FIDN",
  "FIDS",
  "RCID",
]);

/**
 * The content attributes of a feature: everything that survives the
 * exclusions, nulls dropped (GeoJSON exports spell "no value" both ways, and
 * an attribute a producer left null is the same content as one it left out).
 */
/**
 * One canonical string for an evidence CONTENT value, whatever shape the
 * transport gave it. bin/generate-area-edges --write-evidence stores CONTENT
 * as a JSON STRING, but the GeoJSON writer that exports the cached roster back
 * out of the coverage GeoPackage (bin/s57-to-tiles step 2b) auto-detects
 * JSON-shaped strings and re-emits them as raw JSON OBJECTS
 * (AUTODETECT_JSON_STRINGS, default YES) -- and an object never string-equals
 * a side's serialized identity, which silently retained EVERY chart-border
 * edge in the fleet (found 2026-08-14, the Adak swept-area seam). The export
 * now pins the option off, and this canonicalizer makes the comparison immune
 * to the transport either way: strings that parse as objects and objects
 * alike reduce to the same sorted-key serialization contentOf produces.
 */
function canonicalContent(value) {
  let content = value;
  if (typeof content === "string") {
    // The common, intended case: already the exact serialization.
    if (!content.startsWith("{")) return content;
    try {
      content = JSON.parse(content);
    } catch {
      return value;
    }
  }
  if (content === null || typeof content !== "object" || Array.isArray(content))
    return typeof value === "string" ? value : JSON.stringify(value);
  return JSON.stringify(
    Object.fromEntries(
      Object.entries(content)
        .filter(([, v]) => v !== null && v !== undefined)
        .sort(([ka], [kb]) => (ka < kb ? -1 : ka > kb ? 1 : 0)),
    ),
  );
}

function contentOf(properties) {
  const content = {};
  for (const key of Object.keys(properties ?? {}).sort()) {
    if (key.startsWith("_") || IDENTITY_EXCLUSIONS.has(key)) continue;
    const value = properties[key];
    if (value === null || value === undefined) continue;
    content[key] = value;
  }
  return content;
}

const args = process.argv.slice(2);

if (args.includes("--list-classes")) {
  process.stdout.write(AREA_EDGE_CLASSES.join("\n") + "\n");
  process.exit(0);
}

const classPaths = [];
const coveragePaths = [];
const cellCoveragePaths = [];
const neighborCoveragePaths = [];
const neighborAreaEvidencePaths = [];
const positional = [];
let writeEvidence = false;
let evidenceDsnm = "";
let evidenceQfloor = null;

for (let i = 0; i < args.length; i++) {
  if (args[i] === "--area" && args[i + 1]) {
    const spec = args[++i];
    const at = spec.indexOf(":");
    if (at <= 0 || at === spec.length - 1) {
      console.error(`generate-area-edges: malformed --area '${spec}'`);
      process.exit(1);
    }
    classPaths.push({ name: spec.slice(0, at), path: spec.slice(at + 1) });
  } else if (args[i] === "--coverage" && args[i + 1])
    coveragePaths.push(args[++i]);
  else if (args[i] === "--cell-coverage" && args[i + 1])
    cellCoveragePaths.push(args[++i]);
  else if (args[i] === "--neighbor-coverage" && args[i + 1])
    neighborCoveragePaths.push(args[++i]);
  else if (args[i] === "--neighbor-area-evidence" && args[i + 1])
    neighborAreaEvidencePaths.push(args[++i]);
  else if (args[i] === "--write-evidence") writeEvidence = true;
  else if (args[i] === "--evidence-dsnm" && args[i + 1])
    evidenceDsnm = args[++i];
  else if (args[i] === "--evidence-qfloor" && args[i + 1])
    evidenceQfloor = Number(args[++i]);
  else positional.push(args[i]);
}

const outputPath = positional[0];
if (!outputPath || (classPaths.length === 0 && !writeEvidence)) {
  console.error(
    "Usage: generate-area-edges <output.geojson> --area <CLASS:file> [--area <CLASS:file> ...] [--coverage <file>] [--cell-coverage <file>] [--neighbor-coverage <file>] [--neighbor-area-evidence <file>]\n" +
      "       generate-area-edges --list-classes",
  );
  process.exit(1);
}

// extract-coverage uses this mode to cache exactly the identity this generator
// compares, rather than asking shell/OGR SQL to reproduce its exclusions and
// canonical JSON ordering. The deliberately narrow schema can be merged across
// unlike S-57 classes without field drift.
if (writeEvidence) {
  if (!evidenceDsnm || !Number.isFinite(evidenceQfloor)) {
    console.error(
      "generate-area-edges --write-evidence requires --evidence-dsnm and --evidence-qfloor",
    );
    process.exit(1);
  }
  const evidence = [];
  for (const { name, path } of classPaths) {
    for (const feature of readFeatures(path)) {
      if (
        feature.geometry?.type !== "Polygon" &&
        feature.geometry?.type !== "MultiPolygon"
      ) {
        continue;
      }
      evidence.push({
        type: "Feature",
        geometry: feature.geometry,
        properties: {
          CLASS: name,
          CONTENT: JSON.stringify(contentOf(feature.properties)),
          DSNM: evidenceDsnm,
          QFLOOR: evidenceQfloor,
        },
      });
    }
  }
  writeFileSync(
    outputPath,
    JSON.stringify({ type: "FeatureCollection", features: evidence }),
  );
  process.stdout.write(String(evidence.length));
  process.exit(0);
}

/**
 * "There is no feature of this class on that side."
 *
 * A unique object rather than a null-ish identity: an attribute-less feature
 * is a side in its own right (its identity is the empty content set, and two
 * of them beside each other legitimately MERGE -- same class, same content),
 * while the absence of any feature never merges with anything.
 */
const NO_AREA = Symbol("no area feature");

// One seam test for every class: the ring indexes are built once, because the
// chart border is a property of the CELL, not of any class.
const onSeam = chartBorderTest(
  coveragePaths,
  cellCoveragePaths,
  neighborCoveragePaths,
);

// The coverage roster says WHICH chart floor owns the far-side probe at a
// given zoom; the evidence says whether that owner carries this same semantic
// area. Looking only at evidence would let a hidden coarser chart suppress the
// visible finer chart's different/absent boundary.
const neighborCoverage = coveragePolygons(neighborCoveragePaths);
const neighborEvidence = coveragePolygons(neighborAreaEvidencePaths);

function representativeZoom(range) {
  const stamp = (value) => {
    // OGR exports a nullable integer as JSON null. Number(null) and Number("")
    // are both zero, which would turn a fallback interval into z0 and select
    // the wrong serving owner rather than fall through to its real _QZMAX.
    if (value === null || value === undefined || value === "") return null;
    const parsed = Number(value);
    return Number.isFinite(parsed) ? parsed : null;
  };
  const min = stamp(range?._QZMIN);
  if (min !== null) return min;
  return stamp(range?._QZMAX);
}

function servingOwnersAt(point, range) {
  const containing = polygonsContaining(neighborCoverage, point).filter(
    (entry) =>
      typeof entry.properties.DSNM === "string" &&
      Number.isFinite(Number(entry.properties.QFLOOR)),
  );
  const floors = containing.map((entry) => Number(entry.properties.QFLOOR));
  if (floors.length === 0) return null;
  const zoom = representativeZoom(range);
  const reached =
    zoom === null ? floors : floors.filter((floor) => floor <= zoom);
  const floor = reached.length > 0 ? Math.max(...reached) : Math.min(...floors);
  return {
    floor,
    owners: new Set(
      containing
        .filter((entry) => Number(entry.properties.QFLOOR) === floor)
        .map((entry) => entry.properties.DSNM),
    ),
  };
}

function semanticSeamDecision(name, a, b, walk, sides, range) {
  if (!onSeam(a, b, walk)) return false;
  // No semantic roster means an older caller: retain the historical
  // coverage-only suppression rather than changing every edge generator.
  if (neighborAreaEvidencePaths.length === 0) return true;

  const point = outwardProbe(walk);
  const serving = servingOwnersAt(point, range);
  if (serving === null || serving.owners.size === 0)
    return { suppressSides: [] };
  const evidence = polygonsContaining(neighborEvidence, point).filter(
    (entry) =>
      serving.owners.has(entry.properties.DSNM) &&
      Number(entry.properties.QFLOOR) === serving.floor &&
      entry.properties.CLASS === name,
  );
  return {
    suppressSides: sides.flatMap((side, index) =>
      [...serving.owners].every((owner) =>
        evidence.some(
          (entry) =>
            entry.properties.DSNM === owner &&
            canonicalContent(entry.properties.CONTENT) === side.key,
        ),
      )
        ? [index]
        : [],
    ),
  };
}

const out = [];
let segmentTotal = 0;
let seamTotal = 0;
let classTotal = 0;

for (const { name, path } of classPaths) {
  const features = readFeatures(path);
  if (features.length === 0) continue;
  classTotal++;

  const derived = deriveDifferEdges({
    features,
    // One object per feature, shared by every segment it owns: `key` is the
    // identity, `properties` what its edges carry.
    sideOf: (feature) => {
      const content = contentOf(feature.properties);
      return {
        key: JSON.stringify(content),
        properties: { CLASS: name, ...content },
      };
    },
    absent: NO_AREA,
    classify: (sides) => {
      const real = sides.filter((side) => side !== NO_AREA);
      // Every side present and every identity equal: one area, no line.
      if (
        real.length === sides.length &&
        real.every((side) => side.key === real[0].key)
      ) {
        return null;
      }
      // Otherwise one edge PER DISTINCT SIDE, each keeping its own owner's
      // attributes and canonical ring orientation. The signature is the side's
      // identity, so chaining never runs a line through segments whose content
      // differs.
      const edges = [];
      const seen = new Set();
      for (let i = 0; i < sides.length; i++) {
        const side = sides[i];
        if (side === NO_AREA || seen.has(side.key)) continue;
        seen.add(side.key);
        edges.push({
          signature: side.key,
          properties: side.properties,
          side: i,
        });
      }
      return edges;
    },
    onSeam: (a, b, walk, sides, range) =>
      semanticSeamDecision(name, a, b, walk, sides, range),
  });

  out.push(...derived.features);
  segmentTotal += derived.segmentTotal;
  seamTotal += derived.seamTotal;
}

writeFileSync(
  outputPath,
  JSON.stringify({ type: "FeatureCollection", features: out }),
);
console.error(
  `Generated ${out.length} area edges from ${segmentTotal} segments across ${classTotal} classes` +
    (seamTotal ? ` (${seamTotal} dropped at chart boundaries)` : ""),
);
