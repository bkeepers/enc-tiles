#!/usr/bin/env node

// Derives the _AREA_ANCHORS layer: one point per area feature of the
// ship-narrow class set, at which the style draws the feature's centred area
// symbol (the PILBOP02 diamond, the CTNARE51 caution mark and their siblings)
// instead of drawing it once per polygon per tile.
//
// Usage:
//   bin/generate-area-anchors <output.geojson> \
//     --class CTNARE:CTNARE.geojson [--class PILBOP:PILBOP.geojson ...] \
//     [--area-evidence area_evidence.geojson] [--dsnm US5OR2JC] \
//     [--cell-floor <N>]
//
//   bin/generate-area-anchors --list-classes
//     prints the participating classes, one per line -- the same one-source
//     contract as bin/generate-area-edges, pinning bin/s57-to-tiles' loop and
//     the tests to this file's list.
//
// Why this layer exists:
//
//   tippecanoe writes each polygon CLIPPED into every tile it touches, and
//   MapLibre places one centred symbol per fragment whose pole of
//   inaccessibility lands inside its own tile -- so an area straddling a tile
//   edge draws its symbol twice, a corner up to four times, and a multi-part
//   area once more per part. Measured over central Puget at z12: 22% of these
//   layers' polygon features duplicate (RESARE 77/223, TSSLPT 71/120, CBLARE
//   55/156, CTNARE 47/120), and the Port Angeles pilot boarding area draws
//   two diamonds ~63 screen px apart. One POINT per feature lands in exactly
//   one tile at any zoom, which is what makes the symbol appear once.
//
//   This is bin/generate-restriction-anchors MINUS the water-side LNDARE
//   scanline pass -- deliberately a plain-centroid sibling rather than a
//   parameterisation: restriction polygons are drawn to their legal boundary
//   and genuinely span land, where these classes are ship-routing and caution
//   areas drawn to the water they regulate, so the natural label point --
//   bin/generate-labels' placement, the other close precedent -- is already
//   the right one.
//
// GROUPING is by (CLASS, LNAM, interval), for bin/generate-restriction-
// anchors' reasons: LNAM is S-57's feature identifier, so the group is the
// FEATURE rather than a contiguity guess and two abutting but distinct areas
// keep their own symbols; a feature with no LNAM is its own group; and the
// interval keeps the copy ladder's overlapping copies of one feature from
// merging into a single anchor stamped for no interval at all.
//
// ACROSS CELLS, LNAM is not enough -- it is issued per cell, so one area split
// by a chart border is several features with several LNAMs and drew a stack of
// symbols per cell it reaches. --area-evidence, --dsnm and --cell-floor turn on
// the cross-cell ELECTION that removes the rest: the contiguous same-class,
// same-content component across cells elects the smallest DSNM in it, only the
// elected cell emits, and the anchor carries the whole component's AREA. See
// bin/quilt-election.mjs; without those inputs every group keeps its own anchor.
//
// ORIENT-CARRYING features of ORIENT_LEG_CLASSES (RCTLPT) are skipped here:
// they are directed legs and bin/generate-tss-anchors stitches them back into
// lanes. Their undirected siblings, which draw the plain centred mark, stay.
//
// Each output feature carries EVERY non-underscore property of the group's
// LARGEST fragment: the retargeted layers' filters branch on CATPIL, CATBRG,
// WATLEV, CONRAD, CONVIS and the rest of each class's own attributes, and an
// anchor missing one falls into the wrong branch -- so the whole bag rides
// along rather than a curated list. Underscore properties are the pipeline's
// own; of those, the copy ladder's _QZMIN/_QZMAX/_QFALL are re-added
// deliberately, converted to per-feature tippecanoe zoom bounds later by
// bin/stamp-quilt-zooms. On top of the bag:
//
//   CLASS    the S-57 class the feature came from, stamped over any source
//            property of that name
//   AREA     the summed area in square degrees, longitude scaled by
//            cos(latitude) (bin/quilt-anchors.mjs featureArea), computed here
//            so the style can reuse the restriction anchors' screen-size
//            density floor. Summed over the whole ELECTED COMPONENT where an
//            election ran, so the floor measures the feature rather than this
//            cell's share of it; over the group alone where none did

import { writeFileSync } from "fs";

import {
  ANCHOR_TIPPECANOE,
  ORIENT_LEG_CLASSES,
  featureArea,
  hasOrient,
  pointOnSurface,
  ringArea,
} from "./quilt-anchors.mjs";
import { contentOf } from "./quilt-content.mjs";
import { anchorElection } from "./quilt-election.mjs";
import {
  polygons,
  quiltKey,
  quiltRange,
  readFeatures,
} from "./quilt-geojson.mjs";

// The class set, in two shipped rounds.
//
// The SHIP-NARROW TEN came first, because that is where the measured, visible
// duplication was and it kept the property-bag question small: CTNARE and
// PILBOP draw an unconditional centred symbol and were never anchored at all;
// the other eight are in the restriction-anchor class set, but only their
// CS(RESTRN01) cascade symbols are retargeted there and their OWN symbol
// (ESSARE01, CBLARE51, TSLDEF51, ITZARE51, PRCARE51, TSSCRS51, CTNARE51,
// TSSRON51) still drew per fragment.
//
// The WIDENING ROUND then took the deferred own-symbol list: the remaining
// area classes whose unconditional centred symbol duplicates the same way,
// each with the same one-anchor-per-(CLASS, LNAM, interval) contract. (The
// TS_*/T_* tidal and timing carriers also duplicate but stay with their
// layers.)
//
// STILL OUT, deliberately, each with its reason:
//
//   ######   the QUESMRK1 unknown-object carrier is a style-side pseudo class
//            and never names a tile source-layer, so there is no per-class
//            export to anchor.
//   ACHARE   excluded by user ruling -- anchorages are fine as drawn, and
//            widening past that needs a new ruling, not a wider loop.
//   OBSTRN   a HAZARD whose centred symbols are conditional symbology, not a
//            plain per-class mark: the isolated-danger core layers precede the
//            anchor swap in the facade's settings chain (they are forced
//            visible, so an anchor copy would DOUBLE them, never replace
//            them), and its CS(OBSTRN07) branches read the pipeline's
//            _DEPARE_DRVAL1_MAX/_MINPOS columns, which the anchor property
//            bag strips as underscore-prefixed. Deduplicating it belongs with
//            the hazard family's own design round.
//
// Widening is deliberate: add the class HERE and to the bin/s57-to-tiles step
// together (--list-classes is how the tests pin the two against each other).
const AREA_ANCHOR_CLASSES = [
  // The ship-narrow ten.
  "CTNARE",
  "PILBOP",
  "CBLARE",
  "RESARE",
  "DWRTPT",
  "ISTZNE",
  "PRCARE",
  "TSSCRS",
  "TSSLPT",
  "TSSRON",
  // The widening round: the deferred own-symbol classes.
  "ACHBRT",
  "BERTHS",
  "BRIDGE",
  "CHKPNT",
  "CONVYR",
  "CTSARE",
  "FERYRT",
  "FSHFAC",
  "FSHGRD",
  "HRBFAC",
  "LOCMAG",
  "LOGPON",
  "MAGVAR",
  "NEWOBJ",
  "PRDARE",
  // Its ORIENT-carrying features are directed legs and belong to
  // bin/generate-tss-anchors; only the undirected ones anchor here. See
  // ORIENT_LEG_CLASSES in bin/quilt-anchors.mjs.
  "RCTLPT",
  "RECTRC",
  "SMCFAC",
  "SWPARE",
  "WATTUR",
  "WEDKLP",
];

const args = process.argv.slice(2);

if (args.includes("--list-classes")) {
  process.stdout.write(AREA_ANCHOR_CLASSES.join("\n") + "\n");
  process.exit(0);
}

const inputs = [];
const evidencePaths = [];
const positional = [];
let dsnm = "";
let cellFloor = null;

for (let i = 0; i < args.length; i++) {
  if (args[i] === "--class" && args[i + 1]) {
    const value = args[++i];
    const separator = value.indexOf(":");
    inputs.push({
      className: value.slice(0, separator),
      path: value.slice(separator + 1),
    });
  } else if (args[i] === "--area-evidence" && args[i + 1])
    evidencePaths.push(args[++i]);
  else if (args[i] === "--dsnm" && args[i + 1]) dsnm = args[++i];
  else if (args[i] === "--cell-floor" && args[i + 1])
    cellFloor = Number(args[++i]);
  else positional.push(args[i]);
}

const outputPath = positional[0];
if (!outputPath || inputs.length === 0) {
  console.error(
    "Usage: generate-area-anchors <output.geojson> " +
      "--class <CLASS>:<file.geojson> [--class ...] " +
      "[--area-evidence <file.geojson>] [--dsnm <NAME>] [--cell-floor <N>]\n" +
      "       generate-area-anchors --list-classes",
  );
  process.exit(1);
}

for (const { className } of inputs) {
  if (!AREA_ANCHOR_CLASSES.includes(className)) {
    console.error(
      `generate-area-anchors: ${className} is not in AREA_ANCHOR_CLASSES -- ` +
        "widen the set there (and in bin/s57-to-tiles) deliberately, not by " +
        "invocation",
    );
    process.exit(1);
  }
}

// The cross-cell election, over the other cells' semantic roster; inert without
// one. See bin/quilt-election.mjs.
const election = anchorElection({ paths: evidencePaths, dsnm, cellFloor });

// ---- 1. group every feature by (CLASS, LNAM, interval) ---------------------

const groups = new Map();
let anonymous = 0;

for (const { className, path } of inputs) {
  for (const feature of readFeatures(path)) {
    const properties = feature.properties ?? {};
    // A directed leg is bin/generate-tss-anchors' -- it stitches the parts back
    // into one lane and repeats an arrow along it, where this generator's
    // per-cell-copy grouping drew one arrow per part. Only the undirected
    // features of those classes keep their plain centred mark here. See
    // ORIENT_LEG_CLASSES.
    if (ORIENT_LEG_CLASSES.has(className) && hasOrient(properties)) continue;

    const parts = polygons(feature.geometry).filter(
      (polygon) => polygon[0] && polygon[0].length >= 4,
    );
    if (parts.length === 0) continue;

    const range = quiltRange(properties);
    // A feature with no LNAM has no identity to group on and is its own group
    // -- `#n` cannot collide with a real LNAM, which is hex.
    const lnam = properties.LNAM ?? `#${anonymous++}`;
    const id = `${className} ${lnam} ${quiltKey(range)}`;

    let group = groups.get(id);
    if (!group) {
      group = {
        className,
        range,
        area: 0,
        largest: null,
        // The identity the election compares across cells, and every part of
        // this cell's share of the feature to test adjacency with. Taken from
        // the FIRST fragment: the fragments of one LNAM are one feature and
        // carry one content, where `largest` is a placement decision.
        content: contentOf(properties),
        parts: [],
      };
      groups.set(id, group);
    }
    group.parts.push(...parts);
    group.area += featureArea(feature.geometry);
    // The largest FRAGMENT of the group -- outer-ring area, the same measure
    // bin/generate-labels ranks a multipolygon's parts by -- supplies both
    // the anchor point and the property bag.
    for (const polygon of parts) {
      const size = Math.abs(ringArea(polygon[0]));
      if (!group.largest || size > group.largest.size) {
        group.largest = { size, polygon, properties };
      }
    }
  }
}

// ---- 2. one anchor per group, inside its largest fragment ------------------

const features = [];
let elsewhere = 0;

for (const group of groups.values()) {
  // The cross-cell election: one anchor for the whole physical area, emitted by
  // the cell the component elected. A group with no same-band, same-content
  // neighbour elects itself and nothing changes.
  const verdict = election.verdict(group.className, group.content, group.parts);
  if (!verdict.emit) {
    elsewhere++;
    continue;
  }

  // The whole bag of the largest fragment, so the retargeted filters branch
  // exactly as they did on the polygon. Nulls are GDAL's unset columns and
  // carry nothing; underscore properties are the pipeline's own.
  const bag = {};
  for (const [name, value] of Object.entries(group.largest.properties)) {
    if (name.startsWith("_")) continue;
    if (value === null || value === undefined) continue;
    bag[name] = value;
  }
  features.push({
    type: "Feature",
    // See ANCHOR_TIPPECANOE: one anchor per feature, exempt from dot-dropping.
    tippecanoe: ANCHOR_TIPPECANOE,
    geometry: {
      type: "Point",
      coordinates: pointOnSurface(group.largest.polygon),
    },
    properties: {
      ...bag,
      // Stamped AFTER the bag: the computed values win over any source
      // property of the same name.
      CLASS: group.className,
      // The whole component's area, not this cell's share of it: the style's
      // screen-size floor has to measure the FEATURE, and the elected cell's
      // share can be a corner offcut a few metres across.
      AREA: group.area + verdict.area,
      // The interval the group's members serve, converted to tippecanoe
      // bounds later by bin/stamp-quilt-zooms.
      ...group.range,
    },
  });
}

writeFileSync(
  outputPath,
  JSON.stringify({ type: "FeatureCollection", features }),
);
console.error(
  `Generated ${features.length} area anchors` +
    (elsewhere > 0 ? `, ${elsewhere} elected to another chart` : ""),
);
